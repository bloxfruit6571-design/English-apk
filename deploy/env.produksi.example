# ============================================================================
# English Quest API — konfigurasi produksi (template)
# ============================================================================
# Cara pakai:
#   sudo install -d -m 750 -o root -g englishquest /etc/english-quest
#   sudo cp deploy/env.produksi.example /etc/english-quest/api.env
#   sudo nano /etc/english-quest/api.env        # isi nilai sebenarnya
#   sudo chown root:englishquest /etc/english-quest/api.env
#   sudo chmod 640 /etc/english-quest/api.env
#
# ATURAN: template tanpa rahasia ini boleh di Git. Salinan api.env yang sudah
# diisi rahasia TIDAK boleh masuk Git/APK atau dibagikan. Formatnya satu KEY=VALUE per baris, tanpa tanda kutip.
# ============================================================================

# --- [WAJIB] Rahasia server -------------------------------------------------
# Kunci HMAC untuk hash token Premium dan identitas rate-limit. Minimal 32 byte acak.
# Buat sekali:   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Jangan rotasi tanpa rencana migrasi — perubahan membuat token Premium tidak cocok dan
# identitas kuota lama berubah. Hash sesi tidak memakai pepper; tetap simpan pepper stabil.
EQ_TOKEN_PEPPER=GANTI_DENGAN_RAHASIA_ACAK_BUKAN_CONTOH

# --- [WAJIB] Database persisten ---------------------------------------------
# Simpan di luar folder rilis (bukan di dalam /opt/english-quest) supaya rilis baru
# tidak menimpanya dan supaya mudah dicadangkan. Folder induk harus bisa ditulis
# oleh pengguna layanan; server akan membuatnya dengan izin 0700.
EQ_DB_PATH=/var/lib/english-quest/english-quest.sqlite3

# --- [WAJIB] Asal-usul (origin) yang boleh memanggil API ---------------------
# Origin WebView APK Android. Tanpa entri ini, browser/WebView memblokir respons
# API (responsnya sendiri tetap terkirim, tetapi tanpa header CORS).
EQ_ALLOWED_ORIGINS=https://appassets.androidplatform.net

# --- [WAJIB] Alamat dengar --------------------------------------------------
# Mode yang dianjurkan: server hanya di loopback, TLS diakhiri reverse proxy
# (Caddy/nginx) di server yang sama.
EQ_HOST=127.0.0.1
EQ_PORT=8088

# --- [WAJIB untuk mode reverse proxy] ---------------------------------------
# Memberi tahu server bahwa permintaan datang dari proxy tepercaya yang sudah
# menetapkan X-Forwarded-Proto. Tanpa ini server menolak permintaan sebagai
# "bukan HTTPS" (HTTP 400 HTTPS_REQUIRED).
EQ_TRUST_PROXY=1

# --- [DILARANG di produksi] -------------------------------------------------
# Jangan aktifkan dua baris ini di server publik. Keduanya hanya untuk uji lokal.
# EQ_ALLOW_INSECURE_DEV=1        -> mengizinkan HTTP polos di loopback
# EQ_ALLOW_HTTP_DEV=1            -> khusus build APK uji, bukan server

# --- ALTERNATIF: TLS langsung ke server (tanpa reverse proxy) ---------------
# Bila memakai mode ini, jangan set EQ_TRUST_PROXY. EQ_HOST boleh 0.0.0.0 karena
# TLS aktif. Sertifikat harus berisi rantai lengkap (fullchain).
# EQ_TLS_CERT_FILE=/etc/letsencrypt/live/GANTI_DOMAIN_ANDA/fullchain.pem
# EQ_TLS_KEY_FILE=/etc/letsencrypt/live/GANTI_DOMAIN_ANDA/privkey.pem
# EQ_HOST=0.0.0.0

# --- OPSIONAL: pembayaran Premium -------------------------------------------
# Biarkan kosong bila pembayaran belum siap. Selama kosong, semua endpoint
# checkout tidak tersedia. /api/payments/config tetap dapat menjawab dengan available=false.
# EQ_PAYMENT_PROVIDER=            # kosong | sandbox | dana
# EQ_PAYMENT_WEBHOOK_SECRET=      # >=32 byte, hanya untuk simulator sandbox lokal
# EQ_DANA_PUBLIC_KEY_PATH=        # public key DANA (verifikasi notifikasi)
# EQ_DANA_NOTIFY_PATH=            # default: /v1.0/debit/notify
# EQ_DANA_PARTNER_ID=
# EQ_DANA_PRIVATE_KEY_PATH=
# EQ_DANA_CLIENT_SECRET=
