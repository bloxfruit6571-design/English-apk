[Unit]
Description=Cadangan harian database English Quest
Documentation=file:/opt/english-quest/deploy/README-DEPLOY.md
After=englishquest-api.service

[Service]
Type=oneshot
User=englishquest
Group=englishquest
WorkingDirectory=/opt/english-quest
# Berkas yang sama dengan layanan API: memberi EQ_DB_PATH ke skrip cadangan.
EnvironmentFile=/etc/english-quest/api.env
ExecStart=/usr/bin/python3 /opt/english-quest/deploy/cadangkan-db.py backup --simpan 14

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/english-quest
UMask=0077
